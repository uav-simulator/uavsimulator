{
  "PiConnection": {
    "Host": "192.168.1.121",
    "Port": 5051,
    "ReconnectDelayMs": 1000,
    "ReceiveBufferSize": 4096
  },
  "SessionLogs": {
    "Directory": "../logs",
    "RecentFilesLimit": 20
  },
  "Camera": {
    "EnableUdpListener": true,
    "UdpListenPort": 5051,
    "MaxFrameBytes": 3000000,
    "MjpegFps": 12,
    "ProbeIntervalSec": 20,
    "HttpProbeTimeoutMs": 1500,
    "HttpProbePaths": [
      "/?action=stream",
      "/stream.mjpg",
      "/mjpg/video.mjpg",
      "/video_feed",
      "/snapshot.jpg",
      "/cam.jpg"
    ]
  },
  "SensorBridge": {
    "Enabled": true,
    "Port": 8765,
    "TelemetryPath": "/api/telemetry",
    "PollIntervalMs": 800,
    "RequestTimeoutMs": 1200
  },
  "AutopilotSafety": {
    "Enabled": true,
    "EStopDistanceM": 0.12,
    "LateralEStopDistanceM": 0.08,
    "EStopHoldMs": 500,
    "ThrottleMax": 0.5,
    "RampUpMs": 200,
    "DeadmanMs": 300
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
