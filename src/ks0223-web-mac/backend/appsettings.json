{
  "PiConnection": {
    "_comment": "Default Host=127.0.0.1 so a fresh dist build does not target a stranger's robot. Override via appsettings.Development.json or environment variable PiConnection__Host (e.g. 192.168.1.121 for the lab KS0223).",
    "Host": "127.0.0.1",
    "Port": 5051,
    "ReconnectDelayMs": 1000,
    "ReceiveBufferSize": 4096
  },
  "SessionLogs": {
    "Directory": "../logs",
    "RecentFilesLimit": 20
  },
  "Camera": {
    "EnableUdpListener": true,
    "UdpListenPort": 5051,
    "MaxFrameBytes": 3000000,
    "MaxFrameAgeMs": 5000,
    "MjpegFps": 12,
    "ProbeIntervalSec": 20,
    "HttpProbeTimeoutMs": 1500,
    "HttpProbePaths": [
      "/?action=stream",
      "/stream.mjpg",
      "/mjpg/video.mjpg",
      "/video_feed",
      "/snapshot.jpg",
      "/cam.jpg"
    ]
  },
  "SensorBridge": {
    "Enabled": true,
    "Port": 8765,
    "TelemetryPath": "/api/telemetry",
    "PollIntervalMs": 800,
    "RequestTimeoutMs": 1200
  },
  "AutopilotSafety": {
    "Enabled": true,
    "EStopDistanceM": 0.03,
    "LateralEStopDistanceM": 0.05,
    "EStopHoldMs": 400,
    "ThrottleMax": 0.18,
    "RampUpMs": 400,
    "DeadmanMs": 300,
    "SuspiciousJumpFromM": 0.20,
    "SuspiciousJumpToM": 1.50
  },
  "RealRobotCommand": {
    "Enabled": true,
    "ForwardPulseMs": 40,
    "TurnPulseMs": 240,
    "ForwardTrimLeft": 64,
    "ForwardTrimRight": 80,
    "NeutralTrimLeft": 80,
    "NeutralTrimRight": 80,
    "MinForwardClearanceM": 0.03,
    "AutopilotTelemetryStaleMs": 1500,
    "RequireFreshTelemetryForAutopilotForward": true,
    "DisableBackCommand": true,
    "RecoverAutopilotStopWithRightProbe": true,
    "StopRecoveryTurnPulseMs": 80,
    "StopRecoveryMinFrontClearanceM": 0.00
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
