<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Roslyn analyzers + targeted warnings-as-errors so the build
         catches what would otherwise be a silent regression in the
         operator stack. The full TreatWarningsAsErrors is intentionally
         off until Services/* god-files are split (would explode the
         baseline). The narrow WarningsAsErrors list catches the high-
         signal ones: nullable annotations, hidden members, dead branches,
         unused locals/fields. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <WarningsAsErrors>nullable;CS0108;CS0114;CS0162;CS0168;CS0219;CS0414</WarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.26.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="backend.Tests" />
  </ItemGroup>

</Project>
